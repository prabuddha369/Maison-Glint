rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['chatterjee.prabuddha.work@gmail.com', 'founder@maisonglint.com']
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for products
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'currency', 'inStock']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        data.currency is string && data.currency.size() <= 10 &&
        data.inStock is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    // Validation helper for customer orders
    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'customer', 'shippingAddress', 'items', 'total', 'status']) &&
        data.orderId is string && data.orderId.size() <= 128 &&
        data.total is number && data.total >= 0 &&
        data.status is string && data.status in ['pending_payment', 'paid', 'processing', 'shipped', 'cancelled'] &&
        data.customer is map && data.customer.email is string &&
        data.shippingAddress is map &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50;
    }

    // Validation helper for users
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256;
    }

    // 1. Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 2. Orders Collection
    match /orders/{orderId} {
      // Registered order creation with strict temporal validation
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().status == 'pending_payment' &&
        request.time == incoming().createdAt &&
        (!('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid));

      // Single order inspection - Strictly authenticated owner or verified admin
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );

      // Secure query listing
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Order updates & management reserved for administrators
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 3. User Profiles & Addresses
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 4. Admin Role Directory
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow write: if false;
    }
  }
}
